generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  role      String   @default("REVENDA")
  leads     Lead[]
  customers Customer[]
}

model Lead {
  id           String   @id @default(uuid())
  empresa      String
  contato      String
  status       String   @default("LEAD")
  data_criacao DateTime @default(now())
  user_id      String
  user         User     @relation(fields: [user_id], references: [id])
}

model Customer {
  id                String   @id @default(uuid())
  razao_social      String
  cnpj_cpf          String   @unique
  email_financeiro  String
  telefone          String?
  cidade            String?
  estado            String?
  status_cadastro   String   @default("PENDENTE")
  
  user_id           String
  user              User     @relation(fields: [user_id], references: [id])
  contract          Contract?
}

model Contract {
  id             String   @id @default(uuid())
  valor          Decimal
  periodicidade  String
  dia_vencimento Int
  customer_id    String   @unique
  customer       Customer @relation(fields: [customer_id], references: [id])
}